<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>circe_bringup</name>
  <version>0.1.0</version>
  <description>
    Hardware bring-up for CIRCE: Rover Zero 4WD base, RPLidar A1, RealSense D456.
    Owns the device parameter files, the udev rules, and the top-level layered
    launch entry point.
  </description>
  <maintainer email="sz1305568@gmail.com">sharif</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>circe_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <exec_depend>roverrobotics_driver</exec_depend>

  <exec_depend>sllidar_ros2</exec_depend>

  <!-- Masks the rear of the scan (cable spool). -->
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <exec_depend>circe_nav</exec_depend>
  <exec_depend>circe_perception</exec_depend>
  <exec_depend>circe_control</exec_depend>
  <exec_depend>circe_diagnostics</exec_depend>

  <exec_depend>tf2_ros</exec_depend>

  <!-- Used by udev/61-roverrobotics.rules (low_latency). -->
  <exec_depend>setserial</exec_depend>

  <!-- scripts/wait_for.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <!-- bno055 intentionally not declared: no BNO055 is fitted. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
