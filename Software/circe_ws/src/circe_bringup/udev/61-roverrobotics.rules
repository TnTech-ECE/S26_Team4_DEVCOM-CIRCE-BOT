# /dev/rover-control -> Rover Zero 4WD motor controller (low_latency for odometry).

KERNEL=="ttyACM[0-9]", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE:="0666", SYMLINK+="rover-control", RUN+="/bin/setserial /dev/%k low_latency"

# Older/alternate Zero controllers identify by FTDI serial string instead.
KERNEL=="ttyUSB[0-9]", ATTRS{idVendor}=="0403", ATTRS{serial}=="Rover Zero 2", MODE:="0666", SYMLINK+="rover-control", RUN+="/bin/setserial /dev/%k low_latency"
