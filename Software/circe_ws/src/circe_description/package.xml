<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>circe_description</name>
  <version>0.1.0</version>
  <description>
    Robot model for CIRCE: a Rover Zero 4WD carrying an RPLidar A1 and, on a mast
    shelf above it, an Intel RealSense D456.
  </description>
  <maintainer email="sz1305568@gmail.com">sharif</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- urdf/accessories/realsense_d456.urdf.xacro includes _d455.urdf.xacro from
       here. The D456 is the IP65/M12 D455 and has no model of its own upstream. -->
  <exec_depend>realsense2_description</exec_depend>

  <!-- KEEP. urdf/circe_rover.urdf.xacro loads its chassis and wheel meshes
       (flipper_chassis, flipper_track, pro_tire) straight out of this package
       rather than duplicating 24 MB of .dae here. Removing this dependency makes
       the model load with missing geometry, not fail loudly. -->
  <exec_depend>roverrobotics_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
