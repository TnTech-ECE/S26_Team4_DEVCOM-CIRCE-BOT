<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="circe_cable_spool">

    <!--
      Tether spool (motor-driven Cat6 drum) on the rear deck. All six STLs share one
      assembly frame (mm, +X = spool axis, +Y up), so they use the same transform.
      It blocks the lidar's rear arc (about +/-26 deg); scan_sector_filter.yaml masks +/-30 deg.
    -->

    <xacro:arg name="sim_mode" default="false" />

    <!-- Mount pose: as far aft as the nav2 footprint allows. Re-measure the lidar mask if moved. -->
    <xacro:property name="spool_mount_x" value="-0.1588" />
    <xacro:property name="spool_mount_y" value="0.0" />
    <xacro:property name="spool_deck_z"  value="0.0630" />

    <!-- Shared mesh transform; spool_drum_link's origin is on the rotation axis. -->
    <xacro:property name="spool_mesh_rpy"       value="1.5707963 0 1.5707963" />
    <xacro:property name="spool_mount_mesh_xyz" value="-0.132807 -0.145182 0" />
    <xacro:property name="spool_drum_mesh_xyz"  value="-0.132807 -0.145182 -0.139700" />
    <xacro:property name="spool_axis_height"    value="0.139700" />

    <!-- Masses estimated from mesh volume (PLA); weigh the real parts. Inertia scales with mass. -->
    <xacro:property name="spool_drum_mass"  value="1.588" />
    <xacro:property name="spool_mount_mass" value="2.867" />


    <!-- Static frame: end blocks, caps, gearmotor. -->
    <link name="spool_mount_link">

        <xacro:macro name="spool_static_part" params="mesh">
            <visual>
                <origin xyz="${spool_mount_mesh_xyz}" rpy="${spool_mesh_rpy}"/>
                <geometry>
                    <mesh filename="package://circe_description/meshes/${mesh}"
                          scale="0.001 0.001 0.001"/>
                </geometry>
            </visual>
        </xacro:macro>

        <xacro:spool_static_part mesh="spool_motor_end_block.stl" />
        <xacro:spool_static_part mesh="spool_motor_end_block_top.stl" />
        <xacro:spool_static_part mesh="spool_free_end_block.stl" />
        <xacro:spool_static_part mesh="spool_free_end_block_top.stl" />
        <xacro:spool_static_part mesh="spool_motor.stl" />

        <!-- Collision: one box per end block. -->
        <collision>
            <origin xyz="0 -0.1149 0.1053" rpy="0 0 0"/>
            <geometry>
                <box size="0.1908 0.0597 0.2106"/>
            </geometry>
        </collision>

        <collision>
            <origin xyz="0 0.1073 0.1053" rpy="0 0 0"/>
            <geometry>
                <box size="0.1908 0.0445 0.2106"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 -0.0124 0.0931" rpy="0 0 0"/>
            <mass value="${spool_mount_mass}" />
            <inertia ixx="${spool_mount_mass * 0.0151695}"
                     iyy="${spool_mount_mass * 0.0054529}"
                     izz="${spool_mount_mass * 0.0137283}"
                     ixy="0.0" ixz="0.0"
                     iyz="${spool_mount_mass * 0.00058379}" />
        </inertial>
    </link>

    <joint name="spool_mount_to_chassis" type="fixed">
        <parent link="chassis_link"/>
        <child link="spool_mount_link"/>
        <origin xyz="${spool_mount_x} ${spool_mount_y} ${spool_deck_z}" rpy="0 0 0"/>
    </joint>


    <!-- Drum: the only rotating part. -->
    <link name="spool_drum_link">
        <visual>
            <origin xyz="${spool_drum_mesh_xyz}" rpy="${spool_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://circe_description/meshes/spool_drum.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <!-- Collision cylinder at flange diameter. -->
        <collision>
            <origin xyz="0 0.0216 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.1143" length="0.22352"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0.0051 0" rpy="0 0 0"/>
            <mass value="${spool_drum_mass}" />
            <inertia ixx="${spool_drum_mass * 0.0058465}"
                     iyy="${spool_drum_mass * 0.0031109}"
                     izz="${spool_drum_mass * 0.0058509}"
                     ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <!-- Not driven yet; damping/friction keep it from spinning freely. -->
    <joint name="spool_drum_to_mount" type="continuous">
        <parent link="spool_mount_link"/>
        <child link="spool_drum_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 ${spool_axis_height}" rpy="0 0 0"/>
        <dynamics damping="0.05" friction="0.10"/>
    </joint>

</robot>
