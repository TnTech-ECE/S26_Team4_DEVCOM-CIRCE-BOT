<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rplidar_a1">

    <!--
      RPLidar A1 (A1M8) on a riser on chassis_link; lidar_link is the scan plane
      (0.295 m above ground, clearing the tyres). Mount offsets need verifying on the build.
      circe_sensor_mast.urdf.xacro derives the camera shelf height from these values.
    -->
    <xacro:property name="a1_scan_plane_z" value="0.041" />
    <xacro:property name="a1_base_height" value="0.020" />

    <xacro:property name="chassis_top_z" value="0.0630" />
    <xacro:property name="lidar_mount_x" value="0.18" />
    <xacro:property name="lidar_mount_y" value="0.0" />
    <xacro:property name="lidar_mount_z" value="0.170" />
    <!-- 180 deg yaw: scan_sector_filter.yaml's rear mask depends on it. Change both together. -->
    <xacro:property name="lidar_mount_yaw" value="3.1415" />
    <!-- base + rotor = datasheet 60 mm. -->
    <xacro:property name="a1_rotor_height" value="0.040" />
    <xacro:property name="a1_rotor_radius" value="0.0355" />

    <!-- Mesh is in mm with +Y as spin axis; offset aligns its scan plane to lidar_link.
         a1_mesh_yaw is cosmetic only. -->
    <xacro:property name="a1_mesh_xyz" value="-0.037101 0.036518 -0.0415" />
    <xacro:property name="a1_mesh_yaw" value="0" />

    <link name="lidar_link">
        <visual>
            <origin xyz="${a1_mesh_xyz}" rpy="1.5707963 0 ${a1_mesh_yaw}"/>
            <geometry>
                <mesh filename="package://circe_description/meshes/rplidar_a1.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <!-- Collision stays the datasheet box (cheap, and what clearances were measured against). -->
        <collision>
            <origin xyz="0 0 ${-a1_scan_plane_z + 0.030}" rpy="0 0 0"/>
            <geometry>
                <box size="0.0985 0.070 0.060"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 ${-a1_scan_plane_z + 0.030}" rpy="0 0 0"/>
            <mass value="0.170" />
            <inertia ixx="7.0e-5" ixy="0.0" ixz="0.0" iyy="9.0e-5" iyz="0.0" izz="1.1e-4" />
        </inertial>
    </link>

    <joint name="lidar_to_chassis" type="fixed">
        <parent link="chassis_link"/>
        <child link="lidar_link"/>
        <origin xyz="${lidar_mount_x} ${lidar_mount_y} ${lidar_mount_z}"
                rpy="0 0 ${lidar_mount_yaw}"/>
    </joint>

    <!-- Simulated A1 (sim only). -->
    <xacro:arg name="sim_mode" default="false" />
    <xacro:if value="$(arg sim_mode)">
    <gazebo reference="lidar_link">
        <sensor name='gpu_lidar' type='gpu_lidar'>
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                <horizontal>
                    <samples>720</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>0.0</max_angle>
                </vertical>
                </scan>
                <range>
                <min>0.15</min>
                <max>12.0</max>
                <resolution>0.01</resolution>
                </range>
                <!-- Must be inside <lidar>; 0.01 m sigma per datasheet. -->
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
            <visualize>true</visualize>
        </sensor>
    </gazebo>
    </xacro:if>

</robot>
