<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="circe_gazebo_plugins">

    <!-- gz-sim (Harmonic) model systems and wheel friction. Included by circe_rover.urdf.xacro in sim_mode. -->

    <gazebo>
        <!-- Skid-steer as diff drive, two joints per side. -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <num_wheel_pairs>2</num_wheel_pairs>

            <left_joint>rl_wheel_to_chassis</left_joint>
            <left_joint>fl_wheel_to_chassis</left_joint>
            <right_joint>rr_wheel_to_chassis</right_joint>
            <right_joint>fr_wheel_to_chassis</right_joint>
            <wheel_separation>0.36</wheel_separation>
            <!-- Measured rolling radius (sim only). -->
            <wheel_radius>0.1267</wheel_radius>

            <max_linear_acceleration>5</max_linear_acceleration>
            <min_linear_acceleration>-5</min_linear_acceleration>
            <max_angular_acceleration>4</max_angular_acceleration>
            <min_angular_acceleration>-4</min_angular_acceleration>

            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publish_frequency>50</odom_publish_frequency>

            <!-- TF goes to unbridged /tf_gazebo; the EKF owns odom -> base_link. -->
            <topic>/cmd_vel</topic>
            <odom_topic>/odometry/wheels</odom_topic>
            <tf_topic>/tf_gazebo</tf_topic>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
        </plugin>

        <!-- Ground truth for measuring localization error. Sim only; never used by navigation. -->
        <plugin filename="gz-sim-odometry-publisher-system"
                name="gz::sim::systems::OdometryPublisher">
            <odom_frame>ground_truth_odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <odom_topic>/ground_truth/odom</odom_topic>
            <tf_topic>/tf_gazebo_gt</tf_topic>
            <dimensions>3</dimensions>
            <odom_publish_frequency>20</odom_publish_frequency>
        </plugin>
    </gazebo>

    <!-- Wheel friction (starting values; tune against real turning). -->
    <xacro:macro name="wheel_friction" params="link">
        <gazebo reference="${link}">
            <mu1>1.0</mu1>
            <mu2>0.6</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:wheel_friction link="fr_wheel_link" />
    <xacro:wheel_friction link="fl_wheel_link" />
    <xacro:wheel_friction link="rr_wheel_link" />
    <xacro:wheel_friction link="rl_wheel_link" />

</robot>
