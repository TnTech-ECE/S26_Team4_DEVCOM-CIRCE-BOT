<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>circe_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic simulation of CIRCE's hardware layer; circe_nav runs on top unchanged.
  </description>
  <maintainer email="sz1305568@gmail.com">sharif</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Rear-sector scan mask, same as hardware. -->
  <exec_depend>laser_filters</exec_depend>

  <exec_depend>circe_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>circe_nav</exec_depend>
  <exec_depend>circe_perception</exec_depend>
  <exec_depend>circe_diagnostics</exec_depend>

  <!-- For scripts/wait_for.py only. -->
  <exec_depend>circe_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
