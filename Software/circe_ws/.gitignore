# CIRCE ROS 2 workspace (Software/circe_ws in the team repo). Paths starting with /
# are relative to this folder.
# src/roverrobotics_ros2 and src/sllidar_ros2 are git submodules (see .gitmodules);
# their contents live in their own repos, not here.

# --- colcon build products (regenerated by `colcon build`) ---
/build/
/install/
/log/

# --- Python ---
__pycache__/
*.py[cod]
circe_venv/
.venv/

# --- PlatformIO / VS Code (circe_teensy firmware) ---
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# --- Runtime logs and bags ---
circe_logs/
*.log
rosbag2_*/
*.mcap
*.db3

# --- Archives and service backups ---
*.tar.gz
*.tgz
*.zip
rover_services_backup_*

# --- OS / editor clutter ---
.DS_Store
*.swp
*~
