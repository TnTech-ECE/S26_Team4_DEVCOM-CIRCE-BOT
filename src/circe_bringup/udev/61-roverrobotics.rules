# /dev/rover-control -> the Rover Zero 4WD motor controller.
#
# No udev rule for this ships in roverrobotics_ros2, yet config/rover_zero_4wd.yaml
# has always pointed at /dev/rover-control. This file supplies the missing rule.
#
# Install with:
#   sudo cp 61-roverrobotics.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# The Zero's controller presents as an STMicroelectronics Virtual COM Port
# (0483:5740) on ttyACM*. setserial low_latency drops the FTDI/CDC 16 ms read timer,
# which otherwise adds latency to every odometry frame at 15 Hz.
#
# *** KNOWN COLLISION ON THIS MACHINE ***
# /etc/udev/rules.d/99-usb-serial.rules already maps 0483:5740 to SYMLINK "imx5".
# SYMLINK+= accumulates rather than overwriting, so both /dev/imx5 and
# /dev/rover-control appear and the driver works. It is still worth deleting the
# stale imx5 rule if no IMX5 is fitted, so the device has one unambiguous name.
#
# Verify after plugging the rover in:
#   ls -l /dev/rover-control
#   udevadm info -a -n /dev/ttyACM0 | grep -m2 -E 'idVendor|idProduct'

KERNEL=="ttyACM[0-9]", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE:="0666", SYMLINK+="rover-control", RUN+="/bin/setserial /dev/%k low_latency"

# Older/alternate Zero controllers identify by FTDI serial string instead.
KERNEL=="ttyUSB[0-9]", ATTRS{idVendor}=="0403", ATTRS{serial}=="Rover Zero 2", MODE:="0666", SYMLINK+="rover-control", RUN+="/bin/setserial /dev/%k low_latency"
