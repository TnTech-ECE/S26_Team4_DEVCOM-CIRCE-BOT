<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>circe_teensy</name>
  <version>0.1.0</version>
  <description>
    The Teensy 4.0 I/O board for CIRCE: BMS, ultrasonic rangers, e-stop button, GPS and
    the cable spool motor, talking to the Pi 5 over USB serial (/dev/teensy).
    teensy_bridge.py turns the Teensy's frames into ROS topics and forwards spool
    commands and odometry to it.

    The firmware is a PlatformIO project rooted in this directory (platformio.ini,
    src/, include/, lib/). colcon builds it when PlatformIO is installed and installs
    firmware.hex to share/circe_teensy/firmware/. Building never flashes the board.
  </description>
  <maintainer email="sz1305568@gmail.com">sharif</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- scripts/teensy_bridge.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- /gps/fix (NavSatFix). -->
  <exec_depend>sensor_msgs</exec_depend>
  <!-- odom_topic is forwarded to the Teensy as the spool's speed reference. -->
  <exec_depend>nav_msgs</exec_depend>
  <!-- pyserial: opens /dev/teensy. -->
  <exec_depend>python3-serial</exec_depend>

  <!-- launch/teensy_bridge.launch.py -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!--
    Deliberately NOT declared:

    platformio - not a rosdep key, and it only needs to be on the machine that builds
                 the firmware. CMakeLists.txt looks for it and skips the firmware
                 when it is missing, so the laptop still builds this package.
  -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
