<?xml version="1.0" ?>
<!--
  Enclosed 10 x 10 m room with interior structure, for SLAM and Nav2 testing.

  Design notes, because the geometry is not arbitrary:

  * Everything is hand-authored. There is deliberately no Fuel <include>, so the world
    loads with no network. The upstream roverrobotics worlds pull models from
    fuel.ignitionrobotics.org at load time, which fails offline and stalls startup.

  * Walls are 1.0 m tall. The A1 scan plane sits at z = 0.295, so anything shorter than
    that is invisible to the lidar and Nav2 will happily drive through it. If you add
    obstacles, keep them above 0.3 m or accept that they are decoration.

  * The room is closed. slam_toolbox needs the scan to hit something in most directions
    to constrain a pose; an open plane gives it nothing and the map smears.

  * The interior mixes flat walls, corners, and round pillars on purpose. Scan matching
    on flat walls alone is under-constrained along the wall direction, and a rover can
    slide several metres before the solver notices.

  * The centre is left open, with gaps between the dividers wide enough (>1.2 m) for
    the 0.55 x 0.36 m footprint plus inflation_radius 0.35 to plan through.

  *** WORLD-LEVEL SYSTEMS ***
  Sensors and Imu are world-scoped in Harmonic and must be declared here, not in the
  model. See the note in empty.sdf.
-->
<sdf version="1.9">
  <world name="circe_indoor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ Perimeter walls: 10 x 10 m interior, 1.0 m tall ============ -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== Interior dividers: make a corner and a doorway to navigate through ==== -->

    <!-- Runs east from the west wall, stopping 1.5 m short of centre. -->
    <model name="divider_a">
      <static>true</static>
      <pose>-3.0 1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.8 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.8 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.5 0.45 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perpendicular to divider_a: forms an inside corner for scan matching. -->
    <model name="divider_b">
      <static>true</static>
      <pose>-1.1 3.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 2.8 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.8 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.5 0.45 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Leaves a 1.6 m doorway against the east wall. -->
    <model name="divider_c">
      <static>true</static>
      <pose>1.4 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 5.9 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 5.9 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.5 0.45 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ Round pillars: constrain pose along flat walls ============ -->

    <model name="pillar_1">
      <static>true</static>
      <pose>2.8 2.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.45 0.5 1</ambient>
            <diffuse>0.4 0.45 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-3.4 -2.9 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.45 0.5 1</ambient>
            <diffuse>0.4 0.45 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ Crates: 0.5 m tall, just above the 0.295 scan plane ============ -->

    <model name="crate_1">
      <static>true</static>
      <pose>3.6 -3.4 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>-1.9 -1.2 0.25 0 0 -0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      ============ TERRAIN TEST RIG for circe_perception ============

      Everything else in this world is a vertical wall, which the lidar already sees and
      which tells the terrain classifier nothing. These four give each traversability test
      something to bite on, with a known right answer:

        ramp_shallow  ~9 deg   DRIVABLE, mid cost   (slope_warn 10 deg, lethal 25 deg)
        ramp_steep    ~31 deg  LETHAL               (above slope_lethal)
        kerb          0.08 m   LETHAL               (above step_lethal 0.06)
        pit           0.15 m deep  LETHAL           (below drop_lethal 0.08)

      If the two ramps score the same, the slope maths is wrong -- that is the single most
      useful signal this rig provides. Angles are set with the pitch term of <pose>, and
      the ramp is sunk so its low edge meets the floor rather than forming a step: a
      surface-mounted ramp would trip the STEP test at its leading edge and mask the slope
      result entirely.

      All are static and clear of the divider gaps so they do not block navigation tests.
    -->

    <!-- 2.0 x 1.2 slab pitched 9 deg. Rise over the 2 m run is ~0.31 m, so sinking the
         centre by half that puts the downhill edge flush with the floor. -->
    <model name="ramp_shallow">
      <static>true</static>
      <pose>3.0 1.2 0.079 0 -0.157 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.2 0.02</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.2 0.02</size></box></geometry>
          <material>
            <ambient>0.3 0.6 0.3 1</ambient>
            <diffuse>0.3 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Same slab pitched 31 deg. Must classify lethal; the rover should route around. -->
    <model name="ramp_steep">
      <static>true</static>
      <pose>3.0 -1.2 0.257 0 -0.541 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.2 0.02</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.2 0.02</size></box></geometry>
          <material>
            <ambient>0.7 0.3 0.2 1</ambient>
            <diffuse>0.7 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 0.08 m kerb: above step_lethal (0.06) but well under the 0.295 m lidar plane, so
         ONLY the camera can see it. Good end-to-end proof the terrain path is live. -->
    <model name="kerb">
      <static>true</static>
      <pose>-3.2 2.8 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 0.25 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.25 0.08</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.3 1</ambient>
            <diffuse>0.8 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Drop-off test. Gazebo's ground_plane is infinite, so a real hole cannot be cut in
      it. This walls a 1.2 x 1.2 recess with four thin kerbs and floors it 0.15 m down --
      the rover cannot fall in, but the camera sees a surface 0.15 m below local ground,
      which is what drop_lethal (0.08) tests. Approach it from the open north side.
    -->
    <model name="pit_floor">
      <static>true</static>
      <pose>-3.4 0.6 -0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.02</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
