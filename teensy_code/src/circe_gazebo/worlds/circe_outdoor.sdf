<?xml version="1.0" ?>
<!--
  GENERATED FILE - edit generate_outdoor.py and regenerate:
      python3 generate_outdoor.py > circe_outdoor.sdf

  Open Tennessee-like ground for CIRCE: rolling hills, washed-out clay with potholes,
  scattered rock, and mixed hardwood. Every feature is sized against a threshold in
  circe_perception/config/terrain.yaml so that driving the course ANSWERS something.

  *** THE BLIND BAND ***
  The RPLidar scan plane is at z = 0.295 m. Everything shorter than that is invisible
  to it - the rover will drive into it at full speed unless the depth camera sees it.
  Most hazards here are deliberately in that band. Only the trees and the two tallest
  boulders are lidar-visible, and they are there so slam_toolbox has something to match
  against: an open field gives scan matching nothing to hold onto and the map smears.

  *** WHAT EACH ZONE ASKS ***
    step field   x 4..12    a rising series across step_lethal (0.06 m). The rover
                            should drive over the first two and route around the rest.
    erosion deck x 16..28   potholes. North lane varies DEPTH at constant width; south
                            lane varies WIDTH at constant depth. A clear lane runs
                            between them, so "go around" is always available.
    hill field   x -6..-20  spherical caps whose rim slopes bracket slope_lethal
                            (25.2 deg). Smooth, not faceted - see sphere_hill().
    gravel patch (6, 11)    roughness only. It must produce a PREFERENCE, never a wall.

  The rover spawns at the origin facing +x, on clear ground.
-->
<sdf version="1.9">
  <world name="circe_outdoor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sensors and Imu are world-scoped in Harmonic and must be declared here, not in
         the model. Same as circe_indoor.sdf; see the note in empty.sdf. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.65 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>2000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.86</direction>
    </light>

    <!-- Infinite base plane. Nothing can fall out of the world, so a pothole floor is
         always the deck's own underside rather than a hole into nothing. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <!-- *** THE VISUAL SITS 5 mm BELOW THE COLLISION. THIS IS DELIBERATE. ***
             A hill here is a spherical cap, so near its rim the sphere is TANGENT to
             this plane and the two surfaces agree to within a millimetre over a band
             roughly half a metre wide. Coplanar surfaces z-fight: the renderer picks
             between them per-pixel and the ground flickers, and where the plane wins
             it draws OVER the hill's skirt - so the rover, correctly resting on the
             hill, appears to hover above the ground.
             Measured driving onto the 6 deg hill: base_link tracked the sphere's
             analytic surface to within 0.8 mm mean, 7 mm worst. Nothing was floating;
             only the picture was wrong. Dropping the VISUAL 5 mm lets the hill always
             win the depth test near its rim. Collision is untouched, so the physics and
             every terrain measurement are exactly as before. -->
        <visual name="visual">
          <pose>0 0 -0.005 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material>
            <ambient>0.33 0.38 0.22 1</ambient>
            <diffuse>0.33 0.38 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= STEP FIELD: over it, or around it? ================= -->
    <!-- Slabs 3 m wide across the route, so going AROUND is always possible (the
         open ground beyond y = +-1.5 m is clear). Heights step across
         step_warn 0.03 m and step_lethal 0.06 m. Everything up to
         0.25 m is BELOW the 0.295 m scan plane and invisible to the lidar. -->
    <!-- root_30mm: 30 mm - at step_warn exactly: cost, but drivable -->
    <model name="root_30mm">
      <static>true</static>
      <pose>4.0000 0.0000 0.0150 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4500 3.0000 0.0300</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4500 3.0000 0.0300</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- root_55mm: 55 mm - just UNDER step_lethal: should still be driven over -->
    <model name="root_55mm">
      <static>true</static>
      <pose>6.0000 0.0000 0.0275 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4500 3.0000 0.0550</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4500 3.0000 0.0550</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- rock_70mm: 70 mm - just OVER step_lethal: should be routed around -->
    <model name="rock_70mm">
      <static>true</static>
      <pose>8.0000 0.0000 0.0350 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4500 3.0000 0.0700</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4500 3.0000 0.0700</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- rock_120mm: 120 mm - clearly lethal, still lidar-invisible -->
    <model name="rock_120mm">
      <static>true</static>
      <pose>10.0000 0.0000 0.0600 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4500 3.0000 0.1200</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4500 3.0000 0.1200</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- rock_250mm: 250 mm - the worst case: 45 mm below the scan plane -->
    <model name="rock_250mm">
      <static>true</static>
      <pose>12.0000 0.0000 0.1250 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4500 3.0000 0.2500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4500 3.0000 0.2500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- boulder_450mm: 450 mm - the FIRST obstacle in this line the lidar can see -->
    <model name="boulder_450mm">
      <static>true</static>
      <pose>14.0000 0.0000 0.2250 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7000 2.2000 0.4500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7000 2.2000 0.4500</size></box></geometry>
          <material><ambient>0.45 0.45 0.42 1</ambient><diffuse>0.45 0.45 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= EROSION DECK: potholes ================= -->
    <!-- A 12 x 8 m clay slab 0.35 m thick with trenches cut
         through it. NORTH lane varies DEPTH at constant 0.60 m width; SOUTH lane
         varies WIDTH at constant 0.25 m depth. drop_warn 0.04 m,
         drop_lethal 0.08 m. A clear median runs between the lanes and clear
         margins run outside both, so "route around" is always on the table.
         Width matters as much as depth: the wheel is 0.253 m across, so a
         trench much narrower than that is bridged and never felt. -->
    <!-- deck band 0: south margin - clear -->
    <model name="deck_band0">
      <static>true</static>
      <pose>22.0000 -3.4000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0000 1.2000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0000 1.2000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- deck band 1: SOUTH lane: width series at constant 0.25 m depth -->
    <model name="deck_band1_seg0">
      <static>true</static>
      <pose>16.7300 -2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4600 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4600 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band1_seg1">
      <static>true</static>
      <pose>18.7325 -2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.3850 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.3850 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band1_seg2">
      <static>true</static>
      <pose>21.2250 -2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.3000 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.3000 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band1_seg3">
      <static>true</static>
      <pose>23.9375 -2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.6250 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.6250 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band1_seg4">
      <static>true</static>
      <pose>26.8750 -2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2500 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2500 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 8 cm wide x 25 cm deep - drivable - wheel only drops 6 mm -->
    <model name="pothole_b1_0">
      <static>true</static>
      <pose>17.5000 -2.0000 0.0500 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.0800 1.6000 0.1000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0800 1.6000 0.1000</size></box></geometry>
          <material><ambient>0.12 0.10 0.09 1</ambient><diffuse>0.12 0.10 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 15 cm wide x 25 cm deep - drivable - wheel only drops 25 mm -->
    <model name="pothole_b1_1">
      <static>true</static>
      <pose>20.0000 -2.0000 0.0500 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1500 1.6000 0.1000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1500 1.6000 0.1000</size></box></geometry>
          <material><ambient>0.12 0.10 0.09 1</ambient><diffuse>0.12 0.10 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 25 cm wide x 25 cm deep - LETHAL - wheel drops 107 mm, past drop_lethal -->
    <model name="pothole_b1_2">
      <static>true</static>
      <pose>22.5000 -2.0000 0.0500 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2500 1.6000 0.1000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2500 1.6000 0.1000</size></box></geometry>
          <material><ambient>0.12 0.10 0.09 1</ambient><diffuse>0.12 0.10 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 50 cm wide x 25 cm deep - LETHAL - wheel drops 250 mm, past drop_lethal -->
    <model name="pothole_b1_3">
      <static>true</static>
      <pose>25.5000 -2.0000 0.0500 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5000 1.6000 0.1000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5000 1.6000 0.1000</size></box></geometry>
          <material><ambient>0.12 0.10 0.09 1</ambient><diffuse>0.12 0.10 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- deck band 2: median - clear, the always-available way through -->
    <model name="deck_band2">
      <static>true</static>
      <pose>22.0000 0.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0000 2.4000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0000 2.4000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- deck band 3: NORTH lane: depth series at constant 0.60 m width -->
    <model name="deck_band3_seg0">
      <static>true</static>
      <pose>16.6000 2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2000 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2000 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band3_seg1">
      <static>true</static>
      <pose>18.7500 2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.9000 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.9000 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band3_seg2">
      <static>true</static>
      <pose>21.2500 2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.9000 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.9000 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band3_seg3">
      <static>true</static>
      <pose>24.0000 2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4000 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4000 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deck_band3_seg4">
      <static>true</static>
      <pose>26.9000 2.0000 0.1750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2000 1.6000 0.3500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2000 1.6000 0.3500</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 60 cm wide x 4 cm deep - graded - wheel drops 40 mm, past drop_warn -->
    <model name="pothole_b3_0">
      <static>true</static>
      <pose>17.5000 2.0000 0.1550 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6000 1.6000 0.3100</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6000 1.6000 0.3100</size></box></geometry>
          <material><ambient>0.12 0.10 0.09 1</ambient><diffuse>0.12 0.10 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 60 cm wide x 7 cm deep - graded - wheel drops 70 mm, past drop_warn -->
    <model name="pothole_b3_1">
      <static>true</static>
      <pose>20.0000 2.0000 0.1400 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6000 1.6000 0.2800</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6000 1.6000 0.2800</size></box></geometry>
          <material><ambient>0.12 0.10 0.09 1</ambient><diffuse>0.12 0.10 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 60 cm wide x 12 cm deep - LETHAL - wheel drops 120 mm, past drop_lethal -->
    <model name="pothole_b3_2">
      <static>true</static>
      <pose>22.5000 2.0000 0.1150 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6000 1.6000 0.2300</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6000 1.6000 0.2300</size></box></geometry>
          <material><ambient>0.12 0.10 0.09 1</ambient><diffuse>0.12 0.10 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pothole 60 cm wide x 20 cm deep - LETHAL - wheel drops 200 mm, past drop_lethal -->
    <model name="pothole_b3_3">
      <static>true</static>
      <pose>25.5000 2.0000 0.0750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6000 1.6000 0.1500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
