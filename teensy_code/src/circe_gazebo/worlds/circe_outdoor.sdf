          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Access ramps, 8 deg over 2.49 m - well under slope_warn, so
         getting onto the deck is never itself the thing being tested. Each is sunk
         by half its thickness along the normal so its low edge meets the ground
         flush instead of forming a step at the toe. -->
    <model name="ramp_west">
      <static>true</static>
      <pose>14.7548 0.0000 0.1245 0 -0.1396 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5149 8.0000 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5149 8.0000 0.10</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ramp_east">
      <static>true</static>
      <pose>29.2452 0.0000 0.1245 0 0.1396 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5149 8.0000 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5149 8.0000 0.10</size></box></geometry>
          <material><ambient>0.42 0.26 0.16 1</ambient><diffuse>0.42 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= HILL FIELD ================= -->
    <!-- Rim slopes bracket slope_lethal (25.2 deg). Heights are kept small
         because a gentle slope needs an enormous sphere: at 6 deg a 0.20 m rise
         already spreads over a 3.8 m footprint, and a taller one would swallow the
         neighbouring hills. Centres are spaced past the sum of their footprints. -->
    <!-- hill_06deg: 0.20 m tall, 6 deg at the rim (below slope_lethal 25.2 deg). Sphere R=36.51 m, ground footprint radius 3.82 m. -->
    <model name="hill_06deg">
      <static>true</static>
      <pose>-6.0000 -7.0000 -36.3090 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>36.5090</radius></sphere></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
