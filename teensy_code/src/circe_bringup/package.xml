<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>circe_bringup</name>
  <version>0.1.0</version>
  <description>
    Hardware bring-up for CIRCE: Rover Zero 4WD base, RPLidar A1, RealSense D456.
    Owns the device parameter files, the udev rules, and the top-level layered
    launch entry point.
  </description>
  <maintainer email="sz1305568@gmail.com">sharif</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot model, consumed by rover.launch.py via xacro. -->
  <exec_depend>circe_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <!-- Rover Zero 4WD motor driver. -->
  <exec_depend>roverrobotics_driver</exec_depend>

  <!-- Sensor drivers. Upstream's accessories.launch.py referenced both of these
       without declaring either, so `rosdep install` never pulled them. Declared
       here so a fresh clone of this workspace is actually complete. -->
  <exec_depend>sllidar_ros2</exec_depend>

  <!-- scan_to_scan_filter_chain, run by sensors.launch.py between the driver and
       /scan. It masks the rear half of the sweep, where the cable spool and the
       trailing tether sit. Without this the lidar reports the spool as a wall 0.31 m
       behind the rover, to both Nav2 and slam_toolbox. -->
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <!-- Layers composed by circe_bringup.launch.py. -->
  <exec_depend>circe_nav</exec_depend>
  <!-- Layer 3b in circe_bringup.launch.py. Not optional: Nav2's costmaps take their
       lidar from /scan_filtered, which circe_perception's scan_pitch_filter publishes. -->
  <exec_depend>circe_perception</exec_depend>
  <exec_depend>circe_control</exec_depend>
  <!-- Health monitoring, started alongside Layer 1 unless use_diagnostics:=false. -->
  <exec_depend>circe_diagnostics</exec_depend>

  <!-- bench_mode's static odom -> base_link (static_transform_publisher, C++). -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- Required by udev/61-roverrobotics.rules, which ends in
         RUN+="/bin/setserial /dev/%k low_latency"
       to drop the CDC driver's 16 ms read timer. udev runs that on every plug of the
       motor controller; if the binary is absent the RUN silently fails (the symlink is
       still created, so the rover works) and every odometry frame carries up to 16 ms
       of extra latency at 15 Hz into the EKF. Verified missing on a stock install:
       `which setserial` finds nothing; `rosdep resolve setserial` gives apt/setserial.
       Declared here so `rosdep install` over this workspace fits it on the Pi rather than
       leaving it to be noticed as unexplained odometry lag. -->
  <exec_depend>setserial</exec_depend>

  <!-- scripts/wait_for.py, the readiness gate every launch file in this package chains
       its nodes through. rosidl_runtime_py resolves a topic's type name to its Python
       message class at runtime, which is what lets one gate wait on a LaserScan, an
       Odometry and an OccupancyGrid without importing any of them. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <!-- wait_for.py's `from tf2_ros import Buffer, TransformListener` is the PYTHON package.
       The tf2_ros above is the C++ one (static_transform_publisher) and does not provide
       that module. -->
  <exec_depend>tf2_ros_py</exec_depend>

  <!-- Deliberately NOT declared: `bno055`. No BNO055 is fitted, the package is not
       installed and not in circe.repos. Declaring it would make `rosdep install` fail
       on every fresh clone for a sensor nobody has.

       use_imu now defaults TRUE, which does NOT change this: the default imu_source is
       `d456`, so /imu/data comes from the camera's own IMU by way of
       circe_perception/imu_fusion.py and no extra driver package is involved. Only
       imu_source:=bno055 needs this dependency, and that argument selects hardware that
       is not on the robot. Add it here if and when the part is fitted. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
